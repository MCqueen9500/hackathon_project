# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://egc_user:egc_pass@localhost:5432/egc_db"

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ─── OpenRouteService ──────────────────────────────────────────────────────────
ORS_API_KEY="your-openrouteservice-api-key-here"

# ─── Demo geography ────────────────────────────────────────────────────────────
DEMO_CENTER_LAT="12.9716"
DEMO_CENTER_LNG="77.5946"
DEMO_RADIUS_KM="10"

# ─── Emergency timers (demo values in brackets) ────────────────────────────────
# Section 6: DB-polling scheduler reads these at startup
HOSPITAL_APPROVAL_TIMEOUT_SEC=90    # [15 for demo]
POLICE_APPROVAL_TIMEOUT_SEC=120     # [30 for demo]
BED_HOLD_TTL_MIN=20

# ─── Scheduler ─────────────────────────────────────────────────────────────────
SCHEDULER_POLL_INTERVAL_MS=1000

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"

# ─── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=5
UPLOAD_DIR="./uploads"

# ─── Rate limiting ─────────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=60000

# ─── Signal timing (ms) ────────────────────────────────────────────────────────
SIGNAL_RED_MS=30000
SIGNAL_GREEN_MS=25000
SIGNAL_YELLOW_MS=5000

# ─── Deviation reroute ─────────────────────────────────────────────────────────
DEVIATION_THRESHOLD_M=60      # metres off-route to count as deviation
DEVIATION_CONSECUTIVE_N=3     # N consecutive pings before rerouting
